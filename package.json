{
  "name": "opencode-appshot",
  "version": "0.1.0",
  "description": "Attach a screenshot and the readable text of any macOS app window to the OpenCode Desktop composer.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "os": [
    "darwin"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "screenshot",
    "macos",
    "accessibility"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build:helper": "bash scripts/build-helper.sh",
    "build:gui": "vite build",
    "build": "pnpm build:helper && pnpm build:gui",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.4.1",
    "effect": "^4.1.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.4.1",
    "@types/node": "^24.19.2",
    "effect": "4.1.0",
    "solid-js": "^1.9.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.1"
  }
}

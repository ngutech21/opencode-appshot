{
  "name": "opencode-appshot",
  "version": "0.1.0",
  "description": "Attach a screenshot and the readable text of any macOS app window to the OpenCode Desktop composer.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "os": [
    "darwin"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "screenshot",
    "macos",
    "accessibility"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build:helper": "bash scripts/build-helper.sh",
    "build:gui": "vite build",
    "build": "pnpm build:helper && pnpm build:gui",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.4.1",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
